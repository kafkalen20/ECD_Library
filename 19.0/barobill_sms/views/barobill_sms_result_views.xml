<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="barobill_sms_result_view_form" model="ir.ui.view">
        <field name="name">barobill.sms.result.form</field>
        <field name="model">barobill.sms.result</field>
        <field name="arch" type="xml">
            <form string="SMS 발송 결과" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="발송 정보">
                            <field name="from_number"/>
                            <field name="to_number"/>
                            <field name="to_name"/>
                        </group>
                        <group string="발송 결과">
                            <field name="send_date"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == '전송성공'"
                                   decoration-danger="state == '전송실패'"/>
                        </group>
                    </group>
                    <group string="메시지 내용">
                        <field name="contents" nolabel="1"/>
                    </group>
                    <group string="오류 메시지" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="barobill_sms_result_view_list" model="ir.ui.view">
        <field name="name">barobill.sms.result.list</field>
        <field name="model">barobill.sms.result</field>
        <field name="arch" type="xml">
            <list string="SMS 발송 결과" create="0" edit="0">
                <field name="send_date"/>
                <field name="to_number"/>
                <field name="to_name"/>
                <field name="contents" optional="show"/>
                <field name="from_number" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == '전송성공'"
                       decoration-danger="state == '전송실패'"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="barobill_sms_result_action" model="ir.actions.act_window">
        <field name="name">발송 결과</field>
        <field name="res_model">barobill.sms.result</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                SMS 발송 기록이 없습니다
            </p>
            <p>
                SMS 발송 시 자동으로 기록이 저장됩니다.
            </p>
        </field>
    </record>
</odoo>
