<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 설정값은 소스에 하드코딩하지 않는다 — 빈 파라미터만 생성하고 값은 서버에서 직접 입력.
         계정정보(certkey/corpnum/id/mode)는 barobill 공통 키(barobill.*)로 관리.
         FTP 로그인 계정은 공통 '바로빌 ID'(barobill.id)를 사용한다. -->

    <!-- SOAP 서버 URL -->
    <record id="param_barobill_fax_server_test" model="ir.config_parameter">
        <field name="key">barobill_fax.test.server</field>
        <field name="value"></field>
    </record>
    <record id="param_barobill_fax_server_prod" model="ir.config_parameter">
        <field name="key">barobill_fax.prod.server</field>
        <field name="value"></field>
    </record>

    <!-- FTP 호스트/포트 -->
    <record id="param_barobill_fax_ftp_host_test" model="ir.config_parameter">
        <field name="key">barobill_fax.test.ftp_host</field>
        <field name="value"></field>
    </record>
    <record id="param_barobill_fax_ftp_host_prod" model="ir.config_parameter">
        <field name="key">barobill_fax.prod.ftp_host</field>
        <field name="value"></field>
    </record>
    <record id="param_barobill_fax_ftp_port_test" model="ir.config_parameter">
        <field name="key">barobill_fax.test.ftp_port</field>
        <field name="value"></field>
    </record>
    <record id="param_barobill_fax_ftp_port_prod" model="ir.config_parameter">
        <field name="key">barobill_fax.prod.ftp_port</field>
        <field name="value"></field>
    </record>

    <!-- FTP 비밀번호 · 기본 발신번호 -->
    <record id="param_barobill_fax_ftp_password" model="ir.config_parameter">
        <field name="key">barobill_fax.ftp_password</field>
        <field name="value"></field>
    </record>
    <record id="param_barobill_fax_default_from" model="ir.config_parameter">
        <field name="key">barobill_fax.default_from</field>
        <field name="value"></field>
    </record>
</odoo>
