<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="barobill_fax_view_form" model="ir.ui.view">
        <field name="name">barobill.fax.form</field>
        <field name="model">barobill.fax</field>
        <field name="arch" type="xml">
            <form string="팩스 전송">
                <header>
                    <button name="action_send_fax" type="object" string="전송"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_send_fax" type="object" string="재전송"
                            class="btn-primary" invisible="state != 'failed'"/>
                    <button name="action_check_status" type="object" string="상태 조회"
                            class="btn-secondary" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,success,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="발송 정보">
                            <field name="from_number" readonly="state == 'success'"/>
                            <field name="to_number" readonly="state == 'success'"/>
                            <field name="receive_corp" readonly="state == 'success'"/>
                            <field name="receive_name" readonly="state == 'success'"/>
                        </group>
                        <group string="전송 결과">
                            <field name="send_date"/>
                            <field name="send_key"/>
                            <field name="send_state"
                                   help="바로빌 SOAP API 의 raw 전송 상태 코드 (디버깅/감사용). 사용자용 요약 상태는 상단 진행바(state)를 참고하세요."/>
                            <field name="send_result_msg"/>
                            <field name="send_page_count"/>
                            <field name="success_page_count"/>
                        </group>
                    </group>
                    <group string="전송 파일">
                        <field name="file_data" filename="file_name" readonly="state == 'success'"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group string="오류 메시지" invisible="not error_message">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                    <notebook invisible="not result_ids">
                        <page string="전송 결과 이력">
                            <field name="result_ids" nolabel="1">
                                <list string="전송 결과 이력" editable="bottom" create="0" delete="0">
                                    <field name="send_dt"/>
                                    <field name="end_dt"/>
                                    <field name="sender_num"/>
                                    <field name="receiver_num"/>
                                    <field name="receiver_name"/>
                                    <field name="send_state"/>
                                    <field name="send_result_msg"/>
                                    <field name="send_page_count"/>
                                    <field name="success_page_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="barobill_fax_view_list" model="ir.ui.view">
        <field name="name">barobill.fax.list</field>
        <field name="model">barobill.fax</field>
        <field name="arch" type="xml">
            <list string="팩스 전송 목록">
                <field name="to_number"/>
                <field name="receive_name"/>
                <field name="file_name"/>
                <field name="send_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'sent'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'draft'"/>
                <field name="send_state" optional="hide"
                       help="바로빌 SOAP API 의 raw 전송 상태 코드 (디버깅용). 평소에는 state 컬럼만 보면 됩니다."/>
            </list>
        </field>
    </record>

    <!-- Fax Result Form View -->
    <record id="barobill_fax_result_view_form" model="ir.ui.view">
        <field name="name">barobill.fax.result.form</field>
        <field name="model">barobill.fax.result</field>
        <field name="arch" type="xml">
            <form string="팩스 전송 결과" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group string="발송 정보">
                            <field name="fax_id"/>
                            <field name="send_key"/>
                            <field name="sender_num"/>
                            <field name="send_file_name"/>
                        </group>
                        <group string="수신 정보">
                            <field name="receiver_num"/>
                            <field name="receive_corp"/>
                            <field name="receiver_name"/>
                        </group>
                    </group>
                    <group>
                        <group string="전송 상태">
                            <field name="send_state"/>
                            <field name="send_result_msg"/>
                            <field name="send_page_count"/>
                            <field name="success_page_count"/>
                        </group>
                        <group string="일시">
                            <field name="reserve_yn"/>
                            <field name="reserve_dt"/>
                            <field name="send_dt"/>
                            <field name="end_dt"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fax Result List View -->
    <record id="barobill_fax_result_view_list" model="ir.ui.view">
        <field name="name">barobill.fax.result.list</field>
        <field name="model">barobill.fax.result</field>
        <field name="arch" type="xml">
            <list string="팩스 전송 결과 목록" create="0" delete="0">
                <field name="send_dt"/>
                <field name="sender_num"/>
                <field name="receiver_num"/>
                <field name="receiver_name"/>
                <field name="send_file_name"/>
                <field name="send_state"/>
                <field name="send_result_msg"/>
                <field name="send_page_count"/>
                <field name="success_page_count"/>
                <field name="end_dt"/>
            </list>
        </field>
    </record>

    <!-- Fax Result Action -->
    <record id="barobill_fax_result_action" model="ir.actions.act_window">
        <field name="name">전송 결과</field>
        <field name="res_model">barobill.fax.result</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                전송 결과가 없습니다
            </p>
            <p>
                팩스 전송 후 상태 조회를 하면 결과가 여기에 저장됩니다.
            </p>
        </field>
    </record>

    <!-- Action -->
    <record id="barobill_fax_action" model="ir.actions.act_window">
        <field name="name">팩스 전송</field>
        <field name="res_model">barobill.fax</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                팩스 전송 테스트를 시작하세요
            </p>
            <p>
                바로빌 API를 통한 팩스 전송을 테스트할 수 있습니다.
            </p>
        </field>
    </record>
</odoo>
