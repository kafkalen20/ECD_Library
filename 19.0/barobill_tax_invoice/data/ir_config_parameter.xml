<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 설정값은 소스에 하드코딩하지 않는다 — 빈 파라미터만 생성하고 값은 서버에서 직접 입력.
         계정정보(certkey/corpnum/id/mode)는 barobill 공통 키(barobill.*)로 관리.
         참고 endpoint: 운영 https://ws.baroservice.com/TI.asmx?WSDL
                        테스트 https://testws.baroservice.com/TI.asmx?WSDL -->
    <record id="param_barobill_tax_invoice_server_test" model="ir.config_parameter">
        <field name="key">barobill_tax_invoice.test.server</field>
        <field name="value"></field>
    </record>
    <record id="param_barobill_tax_invoice_server_prod" model="ir.config_parameter">
        <field name="key">barobill_tax_invoice.prod.server</field>
        <field name="value"></field>
    </record>
</odoo>
