<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="barobill_tax_invoice_view_form" model="ir.ui.view">
        <field name="name">barobill.tax_invoice.form</field>
        <field name="model">barobill.tax_invoice</field>
        <field name="arch" type="xml">
            <form string="세금계산서">
                <header>
                    <button name="action_regist" type="object" string="저장"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_update" type="object" string="수정"
                            class="btn-secondary" invisible="state != 'save'"/>
                    <button name="action_issue" type="object" string="발급"
                            class="btn-primary" invisible="state != 'save'"
                            confirm="세금계산서를 발급하시겠습니까? 발급 후에는 취소만 가능합니다."/>
                    <button name="action_delete" type="object" string="삭제"
                            class="btn-secondary" invisible="state not in ('save', 'cancel')"
                            confirm="바로빌에서 세금계산서를 삭제하시겠습니까?"/>
                    <button name="action_cancel" type="object" string="발행취소"
                            class="btn-secondary" invisible="state != 'issued'"
                            confirm="발급된 세금계산서를 취소하시겠습니까?"/>
                    <button name="action_popup_url" type="object" string="바로빌 조회"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_reset" type="object" string="초기화"
                            class="btn-secondary" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,save,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="문서 정보">
                            <field name="tax_date" readonly="state != 'draft'"/>
                            <field name="tax_invoice_type" readonly="state != 'draft'"/>
                            <field name="tax_type" readonly="state != 'draft'"/>
                            <field name="purpose_type" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="처리 결과">
                            <field name="management_number"/>
                            <field name="approval_number"/>
                        </group>
                    </group>
                    <group>
                        <group string="공급자">
                            <field name="invoicer_corp_num" readonly="state != 'draft'"/>
                            <field name="invoicer_corp_name" readonly="state != 'draft'"/>
                            <field name="invoicer_ceo_name" readonly="state != 'draft'"/>
                            <field name="invoicer_addr" readonly="state != 'draft'"/>
                            <field name="invoicer_biz_class" readonly="state != 'draft'"/>
                            <field name="invoicer_biz_type" readonly="state != 'draft'"/>
                            <field name="invoicer_contact_name" readonly="state != 'draft'"/>
                            <field name="invoicer_tel" readonly="state != 'draft'"/>
                            <field name="invoicer_email" readonly="state != 'draft'"/>
                        </group>
                        <group string="공급받는자">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="invoicee_corp_num" readonly="state != 'draft'"/>
                            <field name="invoicee_corp_name" readonly="state != 'draft'"/>
                            <field name="invoicee_ceo_name" readonly="state != 'draft'"/>
                            <field name="invoicee_addr" readonly="state != 'draft'"/>
                            <field name="invoicee_biz_class" readonly="state != 'draft'"/>
                            <field name="invoicee_biz_type" readonly="state != 'draft'"/>
                            <field name="invoicee_contact_name" readonly="state != 'draft'"/>
                            <field name="invoicee_tel" readonly="state != 'draft'"/>
                            <field name="invoicee_email" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="품목">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="tax_type" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_name"/>
                                    <field name="product_standard"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="price_tax"/>
                                    <field name="price_total"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_untaxed"/>
                                <field name="amount_tax"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="비고">
                            <field name="note" placeholder="비고를 입력하세요..." readonly="state != 'draft'"/>
                        </page>
                        <page string="처리 이력" invisible="not result_ids">
                            <field name="result_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="create_date"/>
                                    <field name="action"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == '성공'"
                                           decoration-danger="state == '실패'"/>
                                    <field name="management_number" optional="hide"/>
                                    <field name="approval_number" optional="hide"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="오류 메시지" invisible="not error_message">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="barobill_tax_invoice_view_list" model="ir.ui.view">
        <field name="name">barobill.tax_invoice.list</field>
        <field name="model">barobill.tax_invoice</field>
        <field name="arch" type="xml">
            <list string="세금계산서 목록">
                <field name="name"/>
                <field name="tax_date"/>
                <field name="invoicee_corp_name"/>
                <field name="amount_total"/>
                <field name="approval_number" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'save'"
                       decoration-success="state == 'issued'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="barobill_tax_invoice_action" model="ir.actions.act_window">
        <field name="name">세금계산서</field>
        <field name="res_model">barobill.tax_invoice</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                세금계산서를 작성하세요
            </p>
            <p>
                바로빌 API를 통해 세금계산서를 직접 작성/저장/발급할 수 있습니다.
            </p>
        </field>
    </record>
</odoo>
