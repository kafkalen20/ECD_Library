<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="barobill_cash_receipt_view_form" model="ir.ui.view">
        <field name="name">barobill.cash_receipt.form</field>
        <field name="model">barobill.cash_receipt</field>
        <field name="arch" type="xml">
            <form string="현금영수증">
                <header>
                    <button name="action_regist" type="object" string="저장"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_issue" type="object" string="발급"
                            class="btn-primary" invisible="state != 'save'"
                            confirm="현금영수증을 발급하시겠습니까?"/>
                    <button name="action_update" type="object" string="수정"
                            class="btn-secondary" invisible="state != 'save'"/>
                    <button name="action_delete" type="object" string="삭제"
                            class="btn-secondary" invisible="state not in ('save', 'cancel')"
                            confirm="바로빌에서 현금영수증을 삭제하시겠습니까?"/>
                    <button name="action_popup_url" type="object" string="바로빌 조회"
                            class="btn-secondary" invisible="state not in ('save', 'issued')"/>
                    <button name="action_cancel" type="object" string="취소"
                            class="btn-secondary" invisible="state != 'draft'"/>
                    <button name="action_reset" type="object" string="초기화"
                            class="btn-secondary" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,save,issued"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="처리 결과">
                            <field name="management_number"/>
                            <field name="confirm_number"/>
                        </group>
                        <group string="금액">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="tax" readonly="state != 'draft'"/>
                            <field name="amount_total"/>
                        </group>
                    </group>
                    <group>
                        <group string="거래 정보">
                            <field name="trade_date" readonly="state != 'draft'"/>
                            <field name="trade_type" readonly="state != 'draft'"/>
                            <field name="trade_usage" widget="radio" readonly="state != 'draft'"/>
                            <field name="trade_method" widget="radio" readonly="state != 'draft'"/>
                            <field name="identity_num" readonly="state != 'draft'"/>
                            <field name="item_name" readonly="state != 'draft'"/>
                        </group>
                        <group string="고객">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="hp" readonly="state != 'draft'"/>
                            <field name="email" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="가맹점(발행자) 정보">
                        <group>
                            <field name="franchise_corp_num" readonly="state != 'draft'"/>
                            <field name="franchise_corp_name" readonly="state != 'draft'"/>
                            <field name="franchise_ceo_name" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="franchise_member_id" readonly="state != 'draft'"/>
                            <field name="franchise_tel" readonly="state != 'draft'"/>
                            <field name="franchise_addr" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="처리 이력" invisible="not result_ids">
                            <field name="result_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="create_date"/>
                                    <field name="action"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == '성공'"
                                           decoration-danger="state == '실패'"/>
                                    <field name="management_number" optional="hide"/>
                                    <field name="confirm_number" optional="hide"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="오류 메시지" invisible="not error_message">
                        <field name="error_message" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="barobill_cash_receipt_view_list" model="ir.ui.view">
        <field name="name">barobill.cash_receipt.list</field>
        <field name="model">barobill.cash_receipt</field>
        <field name="arch" type="xml">
            <list string="현금영수증 목록">
                <field name="name"/>
                <field name="trade_date"/>
                <field name="trade_usage"/>
                <field name="trade_method"/>
                <field name="identity_num"/>
                <field name="amount_total"/>
                <field name="confirm_number" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'save'"
                       decoration-success="state == 'issued'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="barobill_cash_receipt_view_search" model="ir.ui.view">
        <field name="name">barobill.cash_receipt.search</field>
        <field name="model">barobill.cash_receipt</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="identity_num"/>
                <field name="confirm_number"/>
                <separator/>
                <filter string="소득공제" name="trade_usage_1" domain="[('trade_usage', '=', '1')]"/>
                <filter string="지출증빙" name="trade_usage_2" domain="[('trade_usage', '=', '2')]"/>
                <group>
                    <filter string="상태" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="거래용도" name="group_trade_usage" context="{'group_by': 'trade_usage'}"/>
                    <filter string="거래방법" name="group_trade_method" context="{'group_by': 'trade_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="barobill_cash_receipt_action" model="ir.actions.act_window">
        <field name="name">현금영수증</field>
        <field name="res_model">barobill.cash_receipt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="barobill_cash_receipt_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                현금영수증을 작성하세요
            </p>
            <p>
                바로빌 API를 통해 현금영수증을 직접 작성/저장/발급할 수 있습니다.
            </p>
        </field>
    </record>
</odoo>
