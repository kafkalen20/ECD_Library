<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ecodoobiz 공통 설정 카테고리 -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.edb.common</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Ecodoobiz" name="edb_common"
                     logo="/edb_common/static/description/icon.png">

                    <block title="공통 설정" name="edb_common_settings">
                        <!-- 공용 설정 항목을 여기에 추가 -->
                    </block>

                </app>
            </xpath>
        </field>
    </record>
</odoo>
