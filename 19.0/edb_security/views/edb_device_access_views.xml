<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 보관정책: 접속 내역 보관 일수(기본 365). 0 이면 자동삭제 안 함.
         설정 > 기술 > 시스템 매개변수 에서 조정 가능 -->
    <record id="edb_device_access_retention_days_param" model="ir.config_parameter">
        <field name="key">edb_security.device_access_retention_days</field>
        <field name="value">365</field>
    </record>

    <!-- List -->
    <record id="edb_device_access_list_view" model="ir.ui.view">
        <field name="name">edb.device.access.list</field>
        <field name="model">edb.device.access</field>
        <field name="arch" type="xml">
            <list string="접속 내역" create="false" edit="false" delete="false"
                  default_order="access_datetime desc">
                <field name="access_datetime"/>
                <field name="user_id"/>
                <field name="os_family"/>
                <field name="device_type"/>
                <field name="browser"/>
                <field name="ip_address" optional="hide"/>
                <field name="device" optional="hide"/>
                <field name="access_detail" optional="hide"/>
                <field name="session_identifier" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="edb_device_access_form_view" model="ir.ui.view">
        <field name="name">edb.device.access.form</field>
        <field name="model">edb.device.access</field>
        <field name="arch" type="xml">
            <form string="접속 내역" create="false" edit="false">
                <sheet>
                    <group>
                        <group string="접속 정보">
                            <field name="user_id"/>
                            <field name="access_datetime"/>
                            <field name="ip_address"/>
                        </group>
                        <group string="기기 정보">
                            <field name="os_family"/>
                            <field name="device_type"/>
                            <field name="browser"/>
                            <field name="device"/>
                            <field name="access_detail"/>
                            <field name="session_identifier"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search / Filters -->
    <record id="edb_device_access_search_view" model="ir.ui.view">
        <field name="name">edb.device.access.search</field>
        <field name="model">edb.device.access</field>
        <field name="arch" type="xml">
            <search string="접속 내역 검색">
                <field name="user_id"/>
                <field name="ip_address"/>
                <field name="browser"/>
                <!-- OS 계열 필터 -->
                <filter name="filter_android" string="Android"
                        domain="[('os_family', '=', 'android')]"/>
                <filter name="filter_ios" string="iOS"
                        domain="[('os_family', '=', 'ios')]"/>
                <filter name="filter_windows" string="Windows"
                        domain="[('os_family', '=', 'windows')]"/>
                <filter name="filter_macos" string="macOS"
                        domain="[('os_family', '=', 'macos')]"/>
                <separator/>
                <!-- 기기 구분 필터 -->
                <filter name="filter_mobile" string="모바일"
                        domain="[('device_type', '=', 'mobile')]"/>
                <filter name="filter_computer" string="PC"
                        domain="[('device_type', '=', 'computer')]"/>
                <separator/>
                <filter name="filter_today" string="오늘"
                        domain="[('access_datetime', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group>
                    <filter name="group_user" string="사용자"
                            context="{'group_by': 'user_id'}"/>
                    <filter name="group_os" string="운영체제"
                            context="{'group_by': 'os_family'}"/>
                    <filter name="group_device_type" string="기기 구분"
                            context="{'group_by': 'device_type'}"/>
                    <filter name="group_date" string="접속일"
                            context="{'group_by': 'access_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_edb_device_access" model="ir.actions.act_window">
        <field name="name">접속 내역</field>
        <field name="res_model">edb.device.access</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="edb_device_access_search_view"/>
        <field name="context">{'search_default_filter_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiley_face">아직 접속 내역이 없습니다.</p>
            <p>사용자가 새 기기/브라우저로 접속할 때마다 이력이 기록됩니다.</p>
        </field>
    </record>

    <!-- ═══ 접속 현황 대시보드 (OWL 클라이언트 액션) ═══ -->
    <record id="action_edb_device_access_dashboard" model="ir.actions.client">
        <field name="name">접속 현황</field>
        <field name="tag">edb_device_access_dashboard</field>
    </record>

    <!-- ═══ 보안 모니터링 > 접속 현황 (대시보드) ═══ -->
    <!-- 접속 내역(목록)은 대시보드의 "전체 보기" 버튼으로 접근하므로 별도 메뉴 없음 -->
    <menuitem id="edb_security_menu_device_access_dashboard"
              name="접속 현황"
              parent="menu_root"
              action="action_edb_device_access_dashboard"
              sequence="5"/>

</odoo>
