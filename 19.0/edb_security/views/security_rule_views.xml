<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_rule_list" model="ir.ui.view">
        <field name="name">edb.security.rule.list</field>
        <field name="model">edb.security.rule</field>
        <field name="arch" type="xml">
            <list string="탐지 룰">
                <field name="code"/>
                <field name="name"/>
                <field name="rule_kind"/>
                <field name="event_type"/>
                <field name="aggregate"/>
                <field name="group_by"/>
                <field name="threshold_count"/>
                <field name="window_minutes"/>
                <field name="cooldown_minutes"/>
                <field name="severity" widget="badge" class="o_secmon_severity" options="{'color_field': 'severity_color'}"/>
                <field name="severity_color" column_invisible="1"/>
                <field name="notify_user_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="last_eval" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_security_rule_form" model="ir.ui.view">
        <field name="name">edb.security.rule.form</field>
        <field name="model">edb.security.rule</field>
        <field name="arch" type="xml">
            <form string="탐지 룰">
                <sheet>
                    <widget name="web_ribbon" title="보관됨" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="룰">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="rule_kind"/>
                            <field name="event_type"/>
                            <field name="severity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="조건">
                            <field name="aggregate"/>
                            <field name="group_by"/>
                            <field name="threshold_count"/>
                            <field name="window_minutes"/>
                            <field name="cooldown_minutes"/>
                            <field name="last_eval" readonly="1"/>
                        </group>
                    </group>
                    <group string="알림">
                        <field name="notify_user_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_rule" model="ir.actions.act_window">
        <field name="name">탐지 룰</field>
        <field name="res_model">edb.security.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_security_rule_hit_list" model="ir.ui.view">
        <field name="name">edb.security.rule.hit.list</field>
        <field name="model">edb.security.rule.hit</field>
        <field name="arch" type="xml">
            <list string="룰 발동 이력" create="false">
                <field name="create_date" string="발동시각"/>
                <field name="rule_id"/>
                <field name="severity" widget="badge" class="o_secmon_severity" options="{'color_field': 'severity_color'}"/>
                <field name="severity_color" column_invisible="1"/>
                <field name="group_key_display"/>
                <field name="matched_value"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_security_rule_hit_form" model="ir.ui.view">
        <field name="name">edb.security.rule.hit.form</field>
        <field name="model">edb.security.rule.hit</field>
        <field name="arch" type="xml">
            <form string="룰 발동 이력" create="false" edit="false" delete="false">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="rule_id"/>
                            <field name="severity" widget="badge" class="o_secmon_severity" options="{'color_field': 'severity_color'}"/>
                            <field name="severity_color" invisible="1"/>
                            <field name="group_key_display"/>
                            <field name="matched_value"/>
                        </group>
                        <group>
                            <field name="create_date" string="발동시각"/>
                            <field name="window_start"/>
                            <field name="window_end"/>
                            <field name="ip_trusted"/>
                        </group>
                    </group>
                    <field name="event_ids">
                        <list>
                            <field name="create_date" string="발생시각"/>
                            <field name="event_type"/>
                            <field name="login_display"/>
                            <field name="user_id"/>
                            <field name="client_ip"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_security_rule_hit" model="ir.actions.act_window">
        <field name="name">발동 이력</field>
        <field name="res_model">edb.security.rule.hit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_security_rule_hit" name="발동 이력"
              parent="edb_security.menu_root"
              action="action_security_rule_hit" sequence="20"/>
    <menuitem id="menu_security_rule" name="탐지 룰"
              parent="edb_security.menu_root"
              action="action_security_rule" sequence="30"/>
</odoo>
